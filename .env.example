# Sao chép file này thành .env rồi đổi mọi giá trị trước khi chạy thật.
#   cp .env.example .env
# File .env KHÔNG được commit (đã nằm trong .gitignore).

# ----- Trang admin (/admin) -----
# Thiếu một trong hai biến này thì server TỪ CHỐI khởi động.
ADMIN_USER=admin
ADMIN_PASSWORD=doi-mat-khau-nay-di

# ----- PostgreSQL -----
POSTGRES_DB=dapchuot
POSTGRES_USER=dapchuot
POSTGRES_PASSWORD=doi-mat-khau-database-nay-di

# Host/port của database nhìn từ trong mạng Docker Compose.
PGHOST=db
PGPORT=5432

# ----- Ứng dụng -----
PORT=3000
